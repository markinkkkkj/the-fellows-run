rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // Mesmo critério de admin do Firestore: users/{uid}.role == 'admin'.
    function isAdmin() {
      return isSignedIn()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Fotos de perfil: /users/{userId}/profile.jpg
    match /users/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId
        && (request.resource == null
            || (request.resource.size < 5 * 1024 * 1024
                && request.resource.contentType.matches('image/.*')));
    }

    // Fotos/comprovantes de corrida: /runs/{runId}/participants/{userId}/{fileName}
    match /runs/{runId}/participants/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && (request.auth.uid == userId || isAdmin())
        && (request.resource == null
            || (request.resource.size < 10 * 1024 * 1024
                && request.resource.contentType.matches('image/.*')));
    }

    // Assets gerenciados só por admin: /runs/{runId}/cover.jpg, banners etc.
    match /runs/{runId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
