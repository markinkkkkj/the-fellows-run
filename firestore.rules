rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Perfil: só o dono lê e escreve. Nome e foto dos participantes ficam nas inscrições.
    // O papel nasce como 'user' e não pode ser alterado pelo próprio usuário.
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.get('role', 'user') == 'user';
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.get('role', 'user') == resource.data.get('role', 'user');
    }

    match /runs/{runId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Inscrições em qualquer corrida; o wildcard recursivo cobre a query de collection group.
    match /{path=**}/registrations/{userId} {
      allow read: if signedIn();
      allow write: if signedIn() && (request.auth.uid == userId || isAdmin());
    }
  }
}
